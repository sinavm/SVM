mixed-port: 7890
allow-lan: true
mode: rule
log-level: error
external-controller: 127.0.0.1:9090

proxies:
  - {name: DIRECT, type: http, server: 127.0.0.1, port: 9}

proxy-groups:
  - name: MANUAL
    type: select
    proxies:
      - URL-TEST
      - FALLBACK
      - DIRECT

  - name: URL-TEST
    type: url-test
    url: http://cp.cloudflare.com/
    interval: 60
    tolerance: 50
    proxies:
      - DIRECT

  - name: FALLBACK
    type: fallback
    url: http://cp.cloudflare.com/
    interval: 60
    proxies:
      - DIRECT

rules:
  - DOMAIN-SUFFIX,ir,DIRECT
  - MATCH,MANUAL
